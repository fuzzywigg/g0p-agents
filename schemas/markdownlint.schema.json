{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fuzzywigg/g0p-agents/schemas/markdownlint.schema.json",
  "title": "markdownlint config",
  "description": "Structural schema for .markdownlint.yaml in this docs archive (v23 locks).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "default",
    "MD013",
    "MD024",
    "MD025",
    "MD033"
  ],
  "properties": {
    "default": {
      "type": "boolean",
      "const": true
    },
    "MD013": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "line_length",
        "tables",
        "code_blocks"
      ],
      "properties": {
        "line_length": {
          "type": "integer",
          "minimum": 1,
          "const": 200
        },
        "tables": {
          "type": "boolean",
          "const": false
        },
        "code_blocks": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "MD024": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "siblings_only"
      ],
      "properties": {
        "siblings_only": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "MD025": {
      "type": "boolean",
      "const": false
    },
    "MD033": {
      "type": "boolean",
      "const": false
    }
  }
}
