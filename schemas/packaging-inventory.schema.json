{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fuzzywigg/g0p-agents/schemas/packaging-inventory.schema.json",
  "title": "Archive packaging inventory",
  "description": "Locked packaging paths and historic agent/recipe inventory for this docs-only archive (v7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "required_paths",
    "documented_agents",
    "expected_recipe_names",
    "expected_recipe_files",
    "recipe_bindings",
    "recipe_primary_agents",
    "orchestration_recipe_name",
    "required_ci_jobs",
    "required_python_versions",
    "required_manifest_step_markers",
    "required_schema_files",
    "required_dev_packages",
    "github_agent_files",
    "issue_template_files",
    "pr_template_headings",
    "historic_goose_settings",
    "routing_surfaces",
    "constitution_heading_prefix",
    "prompt_system_header_suffix",
    "specialist_escalation_marker",
    "orchestration_escalation_marker",
    "agent_token_scan_docs",
    "readme_required_phrases",
    "security_required_phrases",
    "contributing_required_phrases",
    "issue_agent_task_headings",
    "issue_bug_report_headings",
    "issue_feature_request_headings",
    "required_archive_docs",
    "known_yaml_configs",
    "cursor_environment_name",
    "dependabot_schedule_interval",
    "dependabot_ecosystems",
    "dependabot_group_names",
    "ci_permissions_contents",
    "ci_artifact_name_prefix",
    "ci_pull_request_branch",
    "ci_concurrency_group_prefix",
    "ci_artifact_upload_if",
    "ci_cancel_in_progress",
    "ci_fail_fast",
    "pyproject_requires_python",
    "pyproject_ruff_target_version",
    "coverage_branch",
    "markdownlint_default",
    "markdownlint_md013_line_length",
    "scratchpad_required_phrases",
    "changelog_required_phrases",
    "postmortem_required_phrases",
    "gitignore_required_patterns",
    "negative_constraint_phrases",
    "license_copyright_holder",
    "license_copyright_marker",
    "historic_recipe_version",
    "github_agent_name",
    "agentic_flows_allowed_files",
    "cursor_install_required_refs",
    "hydration_required_sections",
    "execution_summary_required_phrases",
    "implementation_guide_required_phrases",
    "validator_names",
    "specialist_agents",
    "schema_draft_uri",
    "schema_id_prefix",
    "claude_required_sections",
    "contributing_branch_surfaces",
    "scratchpad_status_markers",
    "min_coverage_fail_under",
    "min_validator_count"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 7
    },
    "required_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\\\]+$"
      }
    },
    "documented_agents": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*Agent$"
      }
    },
    "expected_recipe_names": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "expected_recipe_files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^agentic_flows/[a-z0-9_]+\\.ya?ml$"
      }
    },
    "recipe_bindings": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": {
        "type": "string",
        "pattern": "^agentic_flows/[a-z0-9_]+\\.ya?ml$"
      }
    },
    "recipe_primary_agents": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*Agent$"
      }
    },
    "orchestration_recipe_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "required_ci_jobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "required_python_versions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^3\\.[0-9]+$"
      }
    },
    "required_manifest_step_markers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_schema_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.schema\\.json$"
      }
    },
    "required_dev_packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
      }
    },
    "github_agent_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.github/agents/[A-Za-z0-9._-]+\\.agent\\.md$"
      }
    },
    "issue_template_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.github/ISSUE_TEMPLATE/[A-Za-z0-9._-]+\\.md$"
      }
    },
    "pr_template_headings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historic_goose_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goose_provider",
        "goose_model",
        "extension_type",
        "extension_name"
      ],
      "properties": {
        "goose_provider": {
          "type": "string",
          "const": "anthropic"
        },
        "goose_model": {
          "type": "string",
          "const": "claude-opus-4"
        },
        "extension_type": {
          "type": "string",
          "enum": [
            "builtin",
            "stdio",
            "sse",
            "streamable_http"
          ]
        },
        "extension_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "routing_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "constitution_heading_prefix": {
      "type": "string",
      "minLength": 1
    },
    "prompt_system_header_suffix": {
      "type": "string",
      "minLength": 1
    },
    "specialist_escalation_marker": {
      "type": "string",
      "minLength": 1
    },
    "orchestration_escalation_marker": {
      "type": "string",
      "minLength": 1
    },
    "agent_token_scan_docs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readme_required_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "security_required_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contributing_required_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issue_agent_task_headings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "min_coverage_fail_under": {
      "type": "integer",
      "minimum": 85,
      "maximum": 100
    },
    "min_validator_count": {
      "type": "integer",
      "minimum": 1
    },
    "issue_bug_report_headings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issue_feature_request_headings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_archive_docs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_yaml_configs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cursor_environment_name": {
      "type": "string",
      "minLength": 1
    },
    "dependabot_schedule_interval": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "dependabot_ecosystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependabot_group_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "ci_permissions_contents": {
      "type": "string",
      "minLength": 1
    },
    "ci_artifact_name_prefix": {
      "type": "string",
      "minLength": 1
    },
    "ci_pull_request_branch": {
      "type": "string",
      "minLength": 1
    },
    "ci_concurrency_group_prefix": {
      "type": "string",
      "minLength": 1
    },
    "ci_artifact_upload_if": {
      "type": "string",
      "minLength": 1
    },
    "ci_cancel_in_progress": {
      "type": "boolean"
    },
    "ci_fail_fast": {
      "type": "boolean"
    },
    "pyproject_requires_python": {
      "type": "string",
      "minLength": 1
    },
    "pyproject_ruff_target_version": {
      "type": "string",
      "minLength": 1
    },
    "coverage_branch": {
      "type": "boolean"
    },
    "markdownlint_default": {
      "type": "boolean"
    },
    "markdownlint_md013_line_length": {
      "type": "integer",
      "minimum": 1
    },
    "scratchpad_required_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changelog_required_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "postmortem_required_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gitignore_required_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negative_constraint_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "license_copyright_holder": {
      "type": "string",
      "minLength": 1
    },
    "license_copyright_marker": {
      "type": "string",
      "minLength": 1
    },
    "historic_recipe_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "github_agent_name": {
      "type": "string",
      "minLength": 1
    },
    "agentic_flows_allowed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cursor_install_required_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hydration_required_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_summary_required_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation_guide_required_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validator_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "specialist_agents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*Agent$"
      }
    },
    "schema_draft_uri": {
      "type": "string",
      "minLength": 1
    },
    "schema_id_prefix": {
      "type": "string",
      "minLength": 1
    },
    "claude_required_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contributing_branch_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "scratchpad_status_markers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    }
  }
}
