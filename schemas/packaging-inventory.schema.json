{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fuzzywigg/g0p-agents/schemas/packaging-inventory.schema.json",
  "title": "Archive packaging inventory",
  "description": "Required relative paths that must exist in this docs-only packaging archive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "required_paths"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "required_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\\\]+$"
      }
    }
  }
}
