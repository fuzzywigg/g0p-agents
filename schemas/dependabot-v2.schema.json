{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fuzzywigg/g0p-agents/schemas/dependabot-v2.schema.json",
  "title": "Dependabot config v2 (minimal)",
  "description": "Structural schema for .github/dependabot.yml used by this archive.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "updates"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "updates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["package-ecosystem", "directory", "schedule"],
        "properties": {
          "package-ecosystem": {
            "type": "string",
            "enum": [
              "github-actions",
              "pip",
              "npm",
              "docker",
              "gomod",
              "maven",
              "gradle",
              "nuget",
              "composer",
              "cargo",
              "bundler",
              "terraform"
            ]
          },
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "schedule": {
            "type": "object",
            "additionalProperties": true,
            "required": ["interval"],
            "properties": {
              "interval": {
                "type": "string",
                "enum": ["daily", "weekly", "monthly"]
              }
            }
          }
        }
      }
    }
  }
}
